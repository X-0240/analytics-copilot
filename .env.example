# 复制成 .env 后改值；.env 已被 .gitignore 忽略，不要把真实 key 提交进来。

# 模型（DeepSeek 兼容 OpenAI 协议；AC_FORCE_STUB=0 才会真的调模型）
AC_LLM_BASE_URL=https://api.deepseek.com
AC_LLM_API_KEY=
AC_LLM_MODEL=deepseek-chat
AC_FORCE_STUB=0

# 成本：当日累计到该值即熔断（0 表示不限制）；单价按实际账单口径填
AC_DAILY_COST_BUDGET_CNY=1
AC_PRICE_IN_CNY_PER_1M=2.0
AC_PRICE_OUT_CNY_PER_1M=8.0

# 公网防护（单实例 Demo 的保守默认值）
AC_RATE_LIMIT_PER_MIN=10
AC_MAX_INFLIGHT=4
AC_MAX_BODY_BYTES=8192
AC_SESSION_MAX=1000
AC_SESSION_TTL_SECONDS=1800
# 公网 Demo 共享访问码：非空时 /ask 必须带 Authorization: Bearer <该值>。
# 留空 = 不校验（本地直跑与评测默认如此）。别把真值提交进仓库。
AC_DEMO_TOKEN=

# 数据与日志位置（容器内路径）
AC_DB_PATH=/app/data/analytics.duckdb
AC_LOG_DIR=/app/logs
AC_QUERY_TIMEOUT_SECONDS=8
AC_REQUEST_TIMEOUT_SECONDS=30
